{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skynet-downloads",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-13",
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "skynet.matteo-avigni.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/downloads/*",
      "/updates/*",
      "/api/admin/*"
    ],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "r2_buckets": [
    {
      "binding": "INSTALLERS",
      "bucket_name": "skynet-downloads"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "DOWNLOAD_ANALYTICS",
      "dataset": "skynet_downloads"
    }
  ],
  "analytics": {
    "binding": "ANALYTICS_SQL"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}

